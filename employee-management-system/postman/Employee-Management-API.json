{
  "info": {
    "_postman_id": "employee-management-api",
    "name": "Employee Management API",
    "description": "CRUD API collection for the Employee Management System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "employeeId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Get Employees",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ]
        }
      }
    },
    {
      "name": "Create Employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Amit Joshi\",\n  \"department\": \"IT\",\n  \"role\": \"Frontend Developer\",\n  \"salary\": 30000,\n  \"join_date\": \"2026-10-05\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ]
        }
      }
    },
    {
      "name": "Update Employee",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Amit Joshi\",\n  \"department\": \"IT\",\n  \"role\": \"Senior Frontend Developer\",\n  \"salary\": 35000,\n  \"join_date\": \"2026-10-05\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "{{employeeId}}"
          ]
        }
      }
    },
    {
      "name": "Delete Employee",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "{{employeeId}}"
          ]
        }
      }
    }
  ]
}